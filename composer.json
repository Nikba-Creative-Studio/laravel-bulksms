{
    "name": "nikba/laravel-bulksms",
    "description": "A modern Laravel package to send and manage SMS messages using the BulkSMS JSON REST API.",
    "keywords": ["laravel", "bulksms", "sms", "notification", "api", "messaging"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bargan Nicolai",
            "email": "office@nikba.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Nikba\\BulkSms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nikba\\BulkSms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nikba\\BulkSms\\BulkSmsServiceProvider"
            ],
            "aliases": {
                "BulkSms": "Nikba\\BulkSms\\Facades\\BulkSms"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
